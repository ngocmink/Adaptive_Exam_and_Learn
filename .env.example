# Copy to .env and replace local development values.
POSTGRES_USER=exam
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=exam_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://exam:replace-with-local-password@localhost:5432/exam_dev
TEST_DATABASE_URL=postgresql+psycopg://exam:replace-with-local-password@localhost:5432/exam_test
SECRET_KEY=replace-with-a-random-secret
FLASK_APP=app:create_app
DEMO_ADMIN_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_PASSWORD=
